{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash(go vet *)",
      "Bash(go build *)",
      "Bash(go test *)",
      "Bash(go list *)",
      "Bash(go doc *)",
      "Bash(go version)",
      "Bash(go env)",
      "Bash(go mod tidy)",
      "Bash(go mod verify)",
      "Bash(gofmt -l *)",
      "Bash(gofmt -d *)",
      "Bash(gofmt -w *)",
      "Bash(bash -n *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git grep *)",
      "Bash(git blame *)",
      "Bash(git worktree list *)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git branch --list *)",
      "Bash(git branch -a)",
      "Bash(git branch -r)",
      "Bash(git branch -v)",
      "Bash(git branch -vv)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "PowerShell(go vet *)",
      "PowerShell(go build *)",
      "PowerShell(go test *)",
      "PowerShell(go list *)",
      "PowerShell(go doc *)",
      "PowerShell(go version)",
      "PowerShell(go env)",
      "PowerShell(go mod tidy)",
      "PowerShell(go mod verify)",
      "PowerShell(gofmt -l *)",
      "PowerShell(gofmt -d *)",
      "PowerShell(gofmt -w *)",
      "PowerShell(bash -n *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)",
      "PowerShell(git grep *)",
      "PowerShell(git blame *)",
      "PowerShell(git worktree list *)",
      "PowerShell(git branch)",
      "PowerShell(git branch --show-current)",
      "PowerShell(git branch --list *)",
      "PowerShell(git branch -a)",
      "PowerShell(git branch -r)",
      "PowerShell(git branch -v)",
      "PowerShell(git branch -vv)",
      "PowerShell(gh pr view *)",
      "PowerShell(gh pr list *)",
      "PowerShell(gh pr checks *)",
      "PowerShell(gh pr diff *)",
      "PowerShell(gh issue view *)",
      "PowerShell(gh issue list *)",
      "PowerShell(gh run view *)",
      "PowerShell(gh run list *)"
    ],
    "ask": [
      "Bash(gh pr create *)",
      "Bash(go run ./cmd/adamap *)",
      "Bash(hrn run *)",
      "Bash(hrn batch *)",
      "Bash(hrn eval *)",
      "PowerShell(gh pr create *)",
      "PowerShell(go run ./cmd/adamap *)",
      "PowerShell(hrn run *)",
      "PowerShell(hrn batch *)",
      "PowerShell(hrn eval *)"
    ],
    "deny": [
      "Bash(gh release *)",
      "Bash(gh pr merge *--auto*)",
      "Bash(gh pr merge *--admin*)",
      "Bash(gh api *-X PUT*)",
      "Bash(gh api *--method PUT*)",
      "Bash(gh api *-XPUT*)",
      "Bash(git push)",
      "Bash(git push origin)",
      "Bash(git push -u origin)",
      "Bash(git push --set-upstream origin)",
      "Bash(git push * HEAD)",
      "Bash(git push * *:refs/heads/main)",
      "Bash(git push *refs/heads/main*)",
      "Bash(git push * tag *)",
      "Bash(git push *--all*)",
      "Bash(git push * main *)",
      "Bash(git push * *:main *)",
      "Bash(gh api *releases*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push *--force*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * +*)",
      "Bash(git push * main)",
      "Bash(git push * *:main)",
      "Bash(git push --tags *)",
      "Bash(git push *--tags*)",
      "Bash(git push *--follow-tags*)",
      "Bash(git push *refs/tags/*)",
      "Bash(git push origin v*)",
      "Bash(git push *--mirror*)",
      "Bash(git push *--delete*)",
      "Bash(git tag *)",
      "Bash(go env -w*)",
      "Bash(go env -u*)",
      "PowerShell(gh release *)",
      "PowerShell(gh pr merge *--auto*)",
      "PowerShell(gh pr merge *--admin*)",
      "PowerShell(gh api *-X PUT*)",
      "PowerShell(gh api *--method PUT*)",
      "PowerShell(gh api *-XPUT*)",
      "PowerShell(git push)",
      "PowerShell(git push origin)",
      "PowerShell(git push -u origin)",
      "PowerShell(git push --set-upstream origin)",
      "PowerShell(git push * HEAD)",
      "PowerShell(git push * *:refs/heads/main)",
      "PowerShell(git push *refs/heads/main*)",
      "PowerShell(git push * tag *)",
      "PowerShell(git push *--all*)",
      "PowerShell(git push * main *)",
      "PowerShell(git push * *:main *)",
      "PowerShell(gh api *releases*)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git push *--force*)",
      "PowerShell(git push * -f)",
      "PowerShell(git push * -f *)",
      "PowerShell(git push * +*)",
      "PowerShell(git push * main)",
      "PowerShell(git push * *:main)",
      "PowerShell(git push --tags *)",
      "PowerShell(git push *--tags*)",
      "PowerShell(git push *--follow-tags*)",
      "PowerShell(git push *refs/tags/*)",
      "PowerShell(git push origin v*)",
      "PowerShell(git push *--mirror*)",
      "PowerShell(git push *--delete*)",
      "PowerShell(git tag *)",
      "PowerShell(go env -w*)",
      "PowerShell(go env -u*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.codex/auth.json)",
      "mcp__hrn__batch_merge"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/push-guard.sh",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/go-rules.sh",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
